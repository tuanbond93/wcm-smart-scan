{
  "version": 2,
  "builds": [
    {
      "src": "api/tts.py",
      "use": "@vercel/python"
    },
    {
      "src": "index.html",
      "use": "@vercel/static"
    },
    {
      "src": "style.css",
      "use": "@vercel/static"
    },
    {
      "src": "app.js",
      "use": "@vercel/static"
    },
    {
      "src": "sheet.csv",
      "use": "@vercel/static"
    },
    {
      "src": "smart_scan_pda.html",
      "use": "@vercel/static"
    },
    {
      "src": "zxing-wasm.js",
      "use": "@vercel/static"
    },
    {
      "src": "zxing_reader.wasm",
      "use": "@vercel/static"
    },
    {
      "src": "pilot.css",
      "use": "@vercel/static"
    },
    {
      "src": "pilot.js",
      "use": "@vercel/static"
    },
    {
      "src": "online_sync.js",
      "use": "@vercel/static"
    },
    {
      "src": "config.js",
      "use": "@vercel/static"
    },
    {
      "src": "db.js",
      "use": "@vercel/static"
    },
    {
      "src": "auth.js",
      "use": "@vercel/static"
    },
    {
      "src": "data-adapter.js",
      "use": "@vercel/static"
    },
    {
      "src": "onboarding.js",
      "use": "@vercel/static"
    },
    {
      "src": "manifest.json",
      "use": "@vercel/static"
    },
    {
      "src": "sw.js",
      "use": "@vercel/static"
    },
    {
      "src": "icons/*",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/api/tts",
      "dest": "api/tts.py"
    },
    {
      "src": "/(.*)",
      "dest": "/$1"
    }
  ]
}
